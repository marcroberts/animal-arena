{
  "name": "animal-arena",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",

  // Canonical address. The workers.dev URL stays enabled only so src/index.js
  // can redirect it here (wrangler turns it off by default once routes exist).
  "routes": [{ "pattern": "animal-arena.marcroberts.info", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,

  // Workers Logs: keeps console output and request logs in the dashboard.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // The site is static files; the simulation runs entirely in the browser.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through src/index.js first, so workers.dev paths
    // redirect instead of being served directly.
    "run_worker_first": true,
    // One real page; unknown paths should 404 rather than serve index.html.
    "not_found_handling": "none"
  }
}
